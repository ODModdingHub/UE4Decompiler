<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UE4Decompiler.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="UE4Decompiler.Gui.Views.GraphView"
             x:DataType="vm:GraphViewModel">

    <Grid RowDefinitions="Auto, *" Margin="20">
        <!-- Top Toolbar & Navigation -->
        <Border Grid.Row="0" Background="#1E232B" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#2D333B" BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto, 12, Auto, 8, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Blueprint Inspector" FontSize="16" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center" />
                    <Border Background="#28303C" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClassName}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    </Border>
                    <TextBlock Text=":" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                    <Border Background="#1C2127" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SuperClassName}" FontSize="12" Foreground="#94A3B8" />
                    </Border>
                </StackPanel>

                <!-- Asset Path Input -->
                <TextBox Grid.Column="1" Text="{Binding AssetPath}" Watermark="Asset virtual path (e.g. /Game/BP_Player)" Width="300" />
                <Button Grid.Column="3" Content="Decompile" Command="{Binding DecompileCommand}" IsEnabled="{Binding !IsBusy}" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="14,6" />
                <Button Grid.Column="5" Content="Copy Code" Command="{Binding CopySourceCommand}" Padding="12,6" />
            </Grid>
        </Border>

        <!-- Main Split View -->
        <Grid Grid.Row="1" ColumnDefinitions="300, 16, *">
            <!-- Left Panel: Hierarchy, Functions & Variables -->
            <Border Grid.Column="0" Background="#181C22" CornerRadius="8" Padding="12" BorderBrush="#262C36" BorderThickness="1">
                <TabControl>
                    <!-- Functions & Events Tab -->
                    <TabItem Header="Functions">
                        <ListBox ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="2,4">
                                        <Border Grid.Column="0" Background="#1E3A5F" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" IsVisible="{Binding !IsEvent}">
                                            <TextBlock Text="FUNC" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" />
                                        </Border>
                                        <Border Grid.Column="0" Background="#3B265E" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" IsVisible="{Binding IsEvent}">
                                            <TextBlock Text="EVENT" FontSize="9" FontWeight="Bold" Foreground="#C084FC" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding TokenCount, StringFormat='{}{0} ops'}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <!-- Variables Tab -->
                    <TabItem Header="Variables">
                        <ListBox ItemsSource="{Binding Variables}" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Margin="2,4">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#E2E8F0" />
                                            <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="#38BDF8" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DefaultValue}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <!-- K2 Synthesized Nodes -->
                    <TabItem Header="K2 Nodes">
                        <ListBox ItemsSource="{Binding GraphNodes}" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="3" Margin="2,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#F59E0B" />
                                        <TextBlock Text="{Binding Pins}" FontSize="10" Foreground="#94A3B8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Right Panel: Code & Disassembly View -->
            <Border Grid.Column="2" Background="#181C22" CornerRadius="8" Padding="12" BorderBrush="#262C36" BorderThickness="1">
                <TabControl>
                    <!-- Decompiled Source Tab -->
                    <TabItem Header="Pseudo-Blueprint Source">
                        <ScrollViewer Margin="0,8,0,0">
                            <SelectableTextBlock Text="{Binding DecompiledSource}"
                                                 FontFamily="Consolas,Menlo,Monospace"
                                                 FontSize="12"
                                                 Foreground="#D1D5DB"
                                                 LineHeight="20" />
                        </ScrollViewer>
                    </TabItem>

                    <!-- Low-level Bytecode Disassembly Tab -->
                    <TabItem Header="Bytecode Disassembly">
                        <ScrollViewer Margin="0,8,0,0">
                            <SelectableTextBlock Text="{Binding SelectedFunction.Disassembly}"
                                                 FontFamily="Consolas,Menlo,Monospace"
                                                 FontSize="12"
                                                 Foreground="#38BDF8"
                                                 LineHeight="20" />
                        </ScrollViewer>
                    </TabItem>

                    <!-- Graphviz DOT Tab -->
                    <TabItem Header="Graphviz DOT">
                        <ScrollViewer Margin="0,8,0,0">
                            <SelectableTextBlock Text="{Binding GraphvizText}"
                                                 FontFamily="Consolas,Menlo,Monospace"
                                                 FontSize="12"
                                                 Foreground="#A78BFA"
                                                 LineHeight="20" />
                        </ScrollViewer>
                    </TabItem>

                    <!-- Mermaid Flow Tab -->
                    <TabItem Header="Mermaid Flow">
                        <ScrollViewer Margin="0,8,0,0">
                            <SelectableTextBlock Text="{Binding MermaidText}"
                                                 FontFamily="Consolas,Menlo,Monospace"
                                                 FontSize="12"
                                                 Foreground="#34D399"
                                                 LineHeight="20" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
