<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UE4Decompiler.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="UE4Decompiler.Gui.Views.AssetBrowserView"
             x:DataType="vm:AssetBrowserViewModel">

    <Grid RowDefinitions="Auto, *" Margin="20">
        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="0" Background="#1E232B" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#2D333B" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, 16, 220">
                    <TextBox Grid.Column="0" Text="{Binding SearchFilter}" Watermark="Filter by virtual path (e.g. Characters, Weapons, Materials)..." />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedTypeFilter}" HorizontalAlignment="Stretch" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <!-- Quick Category Filters -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <Button Content="All" Command="{Binding SelectCategoryCommand}" CommandParameter="All" Padding="10,4" FontSize="11" />
                        <Button Content="Blueprints" Command="{Binding SelectCategoryCommand}" CommandParameter="Blueprint" Padding="10,4" FontSize="11" />
                        <Button Content="Static Meshes" Command="{Binding SelectCategoryCommand}" CommandParameter="StaticMesh" Padding="10,4" FontSize="11" />
                        <Button Content="Skeletal Meshes" Command="{Binding SelectCategoryCommand}" CommandParameter="SkeletalMesh" Padding="10,4" FontSize="11" />
                        <Button Content="Textures" Command="{Binding SelectCategoryCommand}" CommandParameter="Texture2D" Padding="10,4" FontSize="11" />
                        <Button Content="Materials" Command="{Binding SelectCategoryCommand}" CommandParameter="Material" Padding="10,4" FontSize="11" />
                        <Button Content="Levels" Command="{Binding SelectCategoryCommand}" CommandParameter="World" Padding="10,4" FontSize="11" />
                        <Button Content="Audio" Command="{Binding SelectCategoryCommand}" CommandParameter="SoundWave" Padding="10,4" FontSize="11" />
                    </StackPanel>

                    <!-- Filter Stats -->
                    <TextBlock Grid.Column="1" Text="{Binding FilterStatsText}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Content Split -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 16, 360">
            <!-- Asset List -->
            <Border Grid.Column="0" Background="#181C22" CornerRadius="8" Padding="8" BorderBrush="#262C36" BorderThickness="1">
                <ListBox ItemsSource="{Binding FilteredAssets}" SelectedItem="{Binding SelectedAsset}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="65, *, 90" Margin="2,3">
                                <Border Grid.Column="0" Background="#262C36" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding VirtualPath}" TextTrimming="CharacterEllipsis" Margin="10,0" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat='{}{0:N0} B'}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Asset Details Inspector Pane -->
            <Border Grid.Column="2" Background="#181C22" CornerRadius="8" Padding="16" BorderBrush="#262C36" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Package Inspector" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" />

                    <!-- Selected Asset Card -->
                    <Border Background="#1E232B" CornerRadius="6" Padding="14" BorderBrush="#2D333B" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <!-- Type Badge & Extension -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Border Grid.Column="0" Background="#2563EB" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding HasSelectedAsset}">
                                    <TextBlock Text="{Binding SelectedTypeBadge}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedExtension}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Path -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Virtual Path" FontSize="11" Foreground="#64748B" />
                                <SelectableTextBlock Text="{Binding SelectedVirtualPath}" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas,Menlo,Monospace" Foreground="#CBD5E1" />
                            </StackPanel>

                            <!-- Mount Point -->
                            <Grid ColumnDefinitions="100, *">
                                <TextBlock Grid.Column="0" Text="Mount Point:" FontSize="11" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedMountPoint}" FontSize="11" Foreground="#CBD5E1" />
                            </Grid>

                            <!-- File Size -->
                            <Grid ColumnDefinitions="100, *">
                                <TextBlock Grid.Column="0" Text="File Size:" FontSize="11" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedSizeFormatted}" FontSize="11" Foreground="#CBD5E1" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasSelectedAsset}">
                        <Button Content="Inspect Blueprint &amp; Bytecode"
                                Command="{Binding InspectBlueprintCommand}"
                                IsVisible="{Binding CanInspectBlueprint}"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,10" />

                        <Button Content="Copy Virtual Path"
                                Command="{Binding CopyPathCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,8" />
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
