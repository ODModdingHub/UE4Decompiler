<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UE4Decompiler.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="UE4Decompiler.Gui.Views.AssetBrowserView"
             x:DataType="vm:AssetBrowserViewModel">

    <Grid RowDefinitions="Auto, *" Margin="20">
        <!-- Filter Toolbar -->
        <Border Grid.Row="0" Background="#252A30" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, 16, 200">
                <TextBox Grid.Column="0" Text="{Binding SearchFilter}" Watermark="Search by virtual path (e.g. Hero, Weapons)..." />
                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedTypeFilter}" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Main Content Split -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 16, 320">
            <!-- Asset List -->
            <Border Grid.Column="0" Background="#20242A" CornerRadius="6" Padding="10">
                <ListBox ItemsSource="{Binding FilteredAssets}" SelectedItem="{Binding SelectedAsset}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="60, *, 100">
                                <Border Grid.Column="0" Background="#2D333B" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Extension}" FontSize="11" FontWeight="Bold" Foreground="#4E9A06" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding VirtualPath}" TextTrimming="CharacterEllipsis" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat='{}{0:N0} B'}" Foreground="#808080" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Preview Pane -->
            <Border Grid.Column="2" Background="#252A30" CornerRadius="6" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Asset Inspection &amp; Preview" FontSize="15" FontWeight="SemiBold" />
                    <Border Background="#1A1D21" CornerRadius="4" Padding="12" MinHeight="260">
                        <TextBlock Text="{Binding AssetPreviewText}" FontFamily="Consolas,Menlo,Monospace"
                                   FontSize="12" Foreground="#C0C0C0" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
