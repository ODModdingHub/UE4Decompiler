<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UE4Decompiler.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="UE4Decompiler.Gui.Views.AssetBrowserView"
             x:DataType="vm:AssetBrowserViewModel">

    <Grid RowDefinitions="Auto, *" Margin="16">
        <!-- Top Filter & Search Bar (FModel style) -->
        <Border Grid.Row="0" Background="#161920" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#2A2E3A" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, 12, 220">
                    <TextBox Grid.Column="0" Text="{Binding SearchFilter}" Watermark="Filter assets by name or path..." />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedTypeFilter}" HorizontalAlignment="Stretch" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <!-- Quick Category Pills -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                        <Button Content="All" Command="{Binding SelectCategoryCommand}" CommandParameter="All" Padding="8,4" FontSize="11" />
                        <Button Content="Blueprints" Command="{Binding SelectCategoryCommand}" CommandParameter="Blueprint" Padding="8,4" FontSize="11" />
                        <Button Content="Static Meshes" Command="{Binding SelectCategoryCommand}" CommandParameter="StaticMesh" Padding="8,4" FontSize="11" />
                        <Button Content="Skeletal Meshes" Command="{Binding SelectCategoryCommand}" CommandParameter="SkeletalMesh" Padding="8,4" FontSize="11" />
                        <Button Content="Textures" Command="{Binding SelectCategoryCommand}" CommandParameter="Texture2D" Padding="8,4" FontSize="11" />
                        <Button Content="Materials" Command="{Binding SelectCategoryCommand}" CommandParameter="Material" Padding="8,4" FontSize="11" />
                        <Button Content="Lighting &amp; Maps" Command="{Binding SelectCategoryCommand}" CommandParameter="World" Padding="8,4" FontSize="11" />
                        <Button Content="Audio" Command="{Binding SelectCategoryCommand}" CommandParameter="SoundWave" Padding="8,4" FontSize="11" />
                        <Button Content="Data &amp; Tables" Command="{Binding SelectCategoryCommand}" CommandParameter="DataTable" Padding="8,4" FontSize="11" />
                        <Button Content="Animations" Command="{Binding SelectCategoryCommand}" CommandParameter="AnimSequence" Padding="8,4" FontSize="11" />
                        <Button Content="Input" Command="{Binding SelectCategoryCommand}" CommandParameter="InputAction" Padding="8,4" FontSize="11" />
                        <Button Content="Curves" Command="{Binding SelectCategoryCommand}" CommandParameter="Curve" Padding="8,4" FontSize="11" />
                        <Button Content="Sound Cues" Command="{Binding SelectCategoryCommand}" CommandParameter="SoundCue" Padding="8,4" FontSize="11" />
                    </StackPanel>

                    <!-- Filter Stats -->
                    <TextBlock Grid.Column="1" Text="{Binding FilterStatsText}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3-Column FModel Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="240, 12, *, 12, 380">
            <!-- Left Column: Folder Hierarchy TreeView -->
            <Border Grid.Column="0" Background="#161920" CornerRadius="8" Padding="10" BorderBrush="#2A2E3A" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FOLDERS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,0,0,8" />
                    <TreeView ItemsSource="{Binding FolderTree}" SelectedItem="{Binding SelectedFolder}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                    <TextBlock Text="📁" FontSize="12" />
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="#E2E8F0" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Center Column: Package Asset List -->
            <Border Grid.Column="2" Background="#161920" CornerRadius="8" Padding="6" BorderBrush="#2A2E3A" BorderThickness="1">
                <ListBox ItemsSource="{Binding FilteredAssets}" SelectedItem="{Binding SelectedAsset}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="55, *, 90" Margin="2,4">
                                <Border Grid.Column="0" Background="#222734" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding VirtualPath}" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center" FontSize="12" Foreground="#F1F5F9" />
                                <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat='{}{0:N0} B'}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right Column: FModel Multi-Tab Inspector -->
            <Border Grid.Column="4" Background="#161920" CornerRadius="8" Padding="12" BorderBrush="#2A2E3A" BorderThickness="1">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="#1E222B" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#292E3A" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Border Grid.Column="0" Background="#6366F1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding HasSelectedAsset}">
                                    <TextBlock Text="{Binding SelectedTypeBadge}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedExtension}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>

                            <SelectableTextBlock Text="{Binding SelectedVirtualPath}" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas,Menlo,Monospace" Foreground="#CBD5E1" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Buttons -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding HasSelectedAsset}">
                        <Button Content="Inspect Blueprint &amp; Bytecode"
                                Command="{Binding InspectBlueprintCommand}"
                                IsVisible="{Binding CanInspectBlueprint}"
                                Background="#6366F1"
                                Foreground="White"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,9" />

                        <Button Content="Export Asset..."
                                Command="{Binding ExportAssetCommand}"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,8" />

                        <Grid ColumnDefinitions="*, 6, *, 6, *">
                            <Button Grid.Column="0" Content="Copy Path" Command="{Binding CopyPathCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6" FontSize="11" />
                            <Button Grid.Column="2" Content="Copy JSON" Command="{Binding CopyJsonCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6" FontSize="11" />
                            <Button Grid.Column="4" Content="Copy C++" Command="{Binding CopyCppCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6" FontSize="11" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- FModel Multi-Tab Inspector Body -->
                    <TabControl>
                        <!-- Properties / Overview Tab -->
                        <TabItem Header="Properties">
                            <ScrollViewer Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <Border Background="#1E222B" CornerRadius="4" Padding="10">
                                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="110, *">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mount Point:" FontSize="11" Foreground="#64748B" Margin="0,3" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedMountPoint}" FontSize="11" Foreground="#CBD5E1" Margin="0,3" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="File Size:" FontSize="11" Foreground="#64748B" Margin="0,3" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSizeFormatted}" FontSize="11" Foreground="#CBD5E1" Margin="0,3" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Storage Type:" FontSize="11" Foreground="#64748B" Margin="0,3" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Cooked Unreal Package" FontSize="11" Foreground="#CBD5E1" Margin="0,3" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Lighting & Shading Tab -->
                        <TabItem Header="Lighting &amp; Render">
                            <ScrollViewer Margin="0,8,0,0">
                                <Border Background="#1E222B" CornerRadius="4" Padding="10">
                                    <SelectableTextBlock Text="{Binding SelectedLightingInfo}"
                                                         FontFamily="Consolas,Menlo,Monospace"
                                                         FontSize="11"
                                                         Foreground="#38BDF8"
                                                         LineHeight="18" />
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Materials & Shaders Tab -->
                        <TabItem Header="Materials">
                            <ScrollViewer Margin="0,8,0,0">
                                <Border Background="#1E222B" CornerRadius="4" Padding="10">
                                    <SelectableTextBlock Text="{Binding SelectedMaterialParams}"
                                                         FontFamily="Consolas,Menlo,Monospace"
                                                         FontSize="11"
                                                         Foreground="#34D399"
                                                         LineHeight="18" />
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- C++ Header Tab -->
                        <TabItem Header="C++ Header">
                            <ScrollViewer Margin="0,8,0,0">
                                <Border Background="#1E222B" CornerRadius="4" Padding="10">
                                    <SelectableTextBlock Text="{Binding SelectedCppHeader}"
                                                         FontFamily="Consolas,Menlo,Monospace"
                                                         FontSize="11"
                                                         Foreground="#FCD34D"
                                                         LineHeight="18" />
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Audio Tab -->
                        <TabItem Header="Audio">
                            <ScrollViewer Margin="0,8,0,0">
                                <Border Background="#1E222B" CornerRadius="4" Padding="10">
                                    <SelectableTextBlock Text="{Binding SelectedAudioInfo}"
                                                         FontFamily="Consolas,Menlo,Monospace"
                                                         FontSize="11"
                                                         Foreground="#F472B6"
                                                         LineHeight="18" />
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Raw JSON Tab -->
                        <TabItem Header="JSON">
                            <ScrollViewer Margin="0,8,0,0">
                                <SelectableTextBlock Text="{Binding SelectedRawJson}"
                                                         FontFamily="Consolas,Menlo,Monospace"
                                                         FontSize="11"
                                                         Foreground="#A78BFA"
                                                         LineHeight="18" />
                            </ScrollViewer>
                        </TabItem>

                        <!-- Dependencies Tab -->
                        <TabItem Header="Imports">
                            <ListBox ItemsSource="{Binding SelectedDependencies}" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,Monospace" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
