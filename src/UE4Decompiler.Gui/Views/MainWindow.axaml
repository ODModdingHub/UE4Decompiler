<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UE4Decompiler.Gui.ViewModels"
        xmlns:views="using:UE4Decompiler.Gui.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="UE4Decompiler.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="UE4Decompiler - Unreal Engine Asset Recovery Suite"
        Width="1160" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#12151A">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="230, *" RowDefinitions="*, 30">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Grid.Row="0" Background="#14171E" BorderBrush="#232833" BorderThickness="0,0,1,0">
            <DockPanel Margin="16, 20">
                <!-- Branding Header -->
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,24">
                    <TextBlock Text="UE4Decompiler" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" />
                    <TextBlock Text="Asset Recovery Suite" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Spacing="6" VerticalAlignment="Top">
                    <Button Content="Home" Command="{Binding NavigateHomeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent" />
                    <Button Content="Asset Browser" Command="{Binding NavigateBrowserCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent" />
                    <Button Content="Blueprint Inspector" Command="{Binding NavigateGraphCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent" />
                    <Button Content="Recovery Queue" Command="{Binding NavigateQueueCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent" />
                    <Button Content="Diagnostics" Command="{Binding NavigateDoctorCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent" />
                    <Button Content="Settings" Command="{Binding NavigateSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content View Host -->
        <Border Grid.Column="1" Grid.Row="0" Background="#181C22">
            <TransitioningContentControl Content="{Binding CurrentPage}">
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                        <views:HomeView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AssetBrowserViewModel}">
                        <views:AssetBrowserView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:GraphViewModel}">
                        <views:GraphView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:JobQueueViewModel}">
                        <views:JobQueueView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DoctorViewModel}">
                        <views:DoctorView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="#0F1116" BorderBrush="#232833" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="v2.0.0 | UE4 &amp; UE5 Engine Support" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
